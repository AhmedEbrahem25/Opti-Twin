# ============================================================
#  Opti-Twin — Environment Configuration
#  v2.0 — anchored to verified Egyptian tariff (EgyptERA Aug 2024)
# ============================================================

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379

# ----- Simulation -----
SIM_MACHINE=EAF_02_EZZ_AIN_SOKHNA
SIM_INTERVAL_SECONDS=3
SIM_TIME_WARP_MINUTES=15
SIM_START_HOUR=17.75

# ----- Egyptian Tariff (verified) -----
# Source: EgyptERA "Current Electricity Tariff" August 2024
# UHV (220-132 kV): 1.60 EGP/kWh — flat rate, no TOU
TARIFF_CLASS=UHV_220-132kV
TARIFF_RATE_EGP_PER_KWH=1.60
TOU_MODE_DEFAULT=false
PF_REFERENCE=0.92

# ----- Grid carbon intensity -----
# Source: IEA / Climatiq — Egypt grid 81% gas (~0.45-0.50 kgCO2/kWh)
GRID_CO2_INTENSITY_KG_PER_KWH=0.50

# ----- EAF Spec (Ezz Flat Steel Ain Sokhna EAF #2, source: GEM) -----
EAF_RATED_TPA=1600000
EAF_FURNACE_SIZE_T=185
EAF_MAX_POWER_MW=110
EAF_MIN_POWER_MW=60
FURNACE_MAX_WALL_TEMP=250
FURNACE_TARGET_BATH_TEMP=1630

# ----- AI Reward Weights -----
RL_ALPHA=1.0       # Energy savings priority
RL_BETA=0.9        # Machine stress penalty
RL_GAMMA=1.8       # Production delay penalty
RL_DELTA=0.7       # Steel quality bonus
RL_EPSILON=0.5     # Electrode economy
RL_ZETA=0.8        # Power-factor penalty (verified Egyptian mechanism)

# ----- Dynamic Pricing Engine (DPE) -----
# Modes: flat | sim_tou | sim_spot | live_eehc
DPE_ENABLED=true
DPE_MODE=sim_spot

# Price signal update intervals
DPE_PRICE_UPDATE_INTERVAL_SECONDS=60
DPE_FORECAST_UPDATE_INTERVAL_SECONDS=1800
DPE_FORECAST_HORIZON_HOURS=24
DPE_FORECAST_STEP_MINUTES=30

# TOU schedule (when DPE_MODE=sim_tou)
TOU_PEAK_START_HOUR=18.0
TOU_PEAK_END_HOUR=22.0
TOU_PEAK_RATE_EGP=2.50
TOU_OFFPEAK_RATE_EGP=1.20

# Spot price parameters (when DPE_MODE=sim_spot)
DPE_SPOT_PEAK_MULTIPLIER_MIN=1.8
DPE_SPOT_PEAK_MULTIPLIER_MAX=2.5
DPE_SPOT_OFFPEAK_MULTIPLIER=0.85
DPE_SPOT_NOISE_STD=0.08

# Demand Response program rates (EGP/MWh)
DPE_DR_ENABLED=true
DPE_DR_MIN_DURATION_MINUTES=15
DPE_DR_CURTAILMENT_RATE_EGP=250
DPE_DR_INTERRUPTIBLE_RATE_EGP=450
DPE_DR_FREQUENCY_RATE_EGP=950

# Capacity market
DPE_CAPACITY_CREDIT_RATE_EGP=80    # EGP/kW/month
DPE_CONTRACTED_FLEXIBILITY_MW=30

# Heat schedule optimizer
DPE_SCHEDULE_HORIZON_HOURS=8

# Steel economics (for DR net-benefit calculation)
STEEL_REVENUE_PER_TONNE=8400
STEEL_COST_PER_TONNE=6100
